  id             Int       @id @default(autoincrement())
  vehicleId      Int       @unique
  purchasePrice  Decimal?  @db.Decimal(18, 2)
  purchaseDate   DateTime? @db.Date
  loanAmount     Decimal?  @db.Decimal(18, 2)
