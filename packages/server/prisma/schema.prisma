generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String   @db.VarChar(20)
  tableName String   @db.VarChar(100)
  recordId  Int
  oldValues Json?
  newValues Json?
  ipAddress String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt], map: "idx_audit_createdAt")
  @@index([tableName, recordId], map: "idx_audit_tableName_recordId")
}

model ColumnPermission {
  id      Int     @id @default(autoincrement())
  roleId  Int
  module  String  @db.VarChar(50)
  column  String  @db.VarChar(100)
  canView Boolean @default(false)
  canEdit Boolean @default(false)
  Role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([roleId, module, column])
  @@index([roleId], map: "idx_column_perm_roleId")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Employee {
  id                                            Int                @id @default(autoincrement())
  code                                          String             @unique @db.VarChar(50)
  fullName                                      String             @db.VarChar(200)
  phone                                         String?            @db.VarChar(20)
  position                                      String?            @db.VarChar(100)
  department                                    String?            @db.VarChar(100)
  isDriver                                      Boolean            @default(false)
  status                                        String             @default("ACTIVE") @db.VarChar(20)
  joinDate                                      DateTime?          @db.Date
  version                                       Int                @default(1)
  createdAt                                     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt                                     DateTime           @default(now()) @db.Timestamptz(6)
  regionId                                      Int?
  salaryType                                    String             @default("PER_TRIP") @db.VarChar(20)
  baseSalary                                    Decimal?           @default(0) @db.Decimal(18, 2)
  AccountingPeriod                              AccountingPeriod[]
  Region                                        Region?            @relation(fields: [regionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  PayrollEntry                                  PayrollEntry[]
  Trip_Trip_lastEditedByIdToEmployee            Trip[]             @relation("Trip_lastEditedByIdToEmployee")
  Trip_Trip_primaryDriverIdToEmployee           Trip[]             @relation("Trip_primaryDriverIdToEmployee")
  Trip_Trip_secondaryDriverIdToEmployee         Trip[]             @relation("Trip_secondaryDriverIdToEmployee")
  TripPlan_TripPlan_primaryDriverIdToEmployee   TripPlan[]         @relation("TripPlan_primaryDriverIdToEmployee")
  TripPlan_TripPlan_secondaryDriverIdToEmployee TripPlan[]         @relation("TripPlan_secondaryDriverIdToEmployee")
  User                                          User?
  Vehicle_Vehicle_primaryDriverIdToEmployee     Vehicle[]          @relation("Vehicle_primaryDriverIdToEmployee")
  Vehicle_Vehicle_secondaryDriverIdToEmployee   Vehicle[]          @relation("Vehicle_secondaryDriverIdToEmployee")

  @@index([code], map: "idx_employee_code")
  @@index([isDriver], map: "idx_employee_isDriver")
  @@index([status], map: "idx_employee_status")
  @@index([regionId], map: "idx_employee_regionid")
}

model ModulePermission {
  id        Int     @id @default(autoincrement())
  roleId    Int
  module    String  @db.VarChar(50)
  canView   Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)
  Role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([roleId, module])
  @@index([roleId], map: "idx_module_perm_roleId")
}

model Role {
  id               Int                @id @default(autoincrement())
  name             String             @unique @db.VarChar(100)
  description      String?            @db.VarChar(500)
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @db.Timestamptz(6)
  ColumnPermission ColumnPermission[]
  ModulePermission ModulePermission[]
  User             User[]
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(100)
  passwordHash String    @db.VarChar(500)
  roleId       Int
  employeeId   Int?      @unique
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz(6)
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @db.Timestamptz(6)
  Employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Role         Role      @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([employeeId], map: "idx_user_employeeId")
  @@index([roleId], map: "idx_user_roleId")
}

model migrations {
  id         Int      @id @default(dbgenerated("nextval('_migrations_id_seq'::regclass)"))
  name       String   @unique @db.VarChar(255)
  executedAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("_migrations")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
