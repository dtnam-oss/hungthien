  updatedAt                                    DateTime            @default(now()) @db.Timestamptz(6)
  chassisNumber                                String?             @db.VarChar(50)
  engineNumber                                 String?             @db.VarChar(50)
  grossWeight                                  Int?
  curbWeight                                   Int?
  payloadCapacity                              Int?
  lengthMm                                     Int?
  widthMm                                      Int?
  heightMm                                     Int?
