  Employee_Vehicle_secondaryDriverIdToEmployee Employee?           @relation("Vehicle_secondaryDriverIdToEmployee", fields: [secondaryDriverId], references: [id], onUpdate: NoAction, map: "fk_vehicle_secondaryDriver")
  Supplier                                     Supplier?           @relation(fields: [supplierId], references: [id], onUpdate: NoAction, map: "fk_vehicle_supplier")
  VehicleFinance                               VehicleFinance?
  VehicleInspection                            VehicleInspection[]

  @@index([ownerType], map: "idx_vehicle_ownerType")
  @@index([plateNumber], map: "idx_vehicle_plateNumber")
  @@index([primaryDriverId], map: "idx_vehicle_primaryDriverId")
  @@index([status], map: "idx_vehicle_status")
  @@index([supplierId], map: "idx_vehicle_supplierId")
}

